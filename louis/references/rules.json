[
  {
    "id": "ui.tone.no_apologies",
    "scope": ["interface", "tone", "error"],
    "component": "any",
    "severity": "warning",
    "lintable": true,
    "rule": "In ordinary UI errors, drop the apology and give the state or the action instead.",
    "bad_patterns": ["oops", "sorry", "unfortunately", "we apologize", "apologies"],
    "good_examples": ["Couldn't load. Try again"],
    "exceptions": [],
    "notes": ""
  },
  {
    "id": "ui.tone.no_hype",
    "scope": ["interface", "tone"],
    "component": "any",
    "severity": "suggestion",
    "lintable": true,
    "rule": "In transactional UI, avoid hype, jokes, and emotional inserts.",
    "bad_patterns": ["awesome", "amazing", "great news", "congrats", "congratulations", "yay", "woohoo"],
    "good_examples": ["Done", "Request sent"],
    "exceptions": [],
    "notes": ""
  },
  {
    "id": "ui.error.generic",
    "scope": ["interface", "error"],
    "component": "error",
    "severity": "warning",
    "lintable": true,
    "rule": "A generic error should say what failed and what the user can do.",
    "bad_patterns": ["something went wrong", "an error occurred", "error occurred"],
    "good_examples": ["Couldn't load. Try again", "Couldn't complete that. Try again"],
    "exceptions": [],
    "notes": ""
  },
  {
    "id": "ui.button.no_i_want",
    "scope": ["interface", "button"],
    "component": "button",
    "severity": "warning",
    "lintable": true,
    "rule": "A button should usually be the user's direct action.",
    "bad_patterns": ["i want to ", "i'd like to ", "i would like to ", "let me "],
    "good_examples": ["Delete", "Open", "Connect"],
    "exceptions": [],
    "notes": ""
  },
  {
    "id": "ui.button.no_system_present_tense",
    "scope": ["interface", "button"],
    "component": "button",
    "severity": "warning",
    "lintable": true,
    "rule": "Do not use the system's present tense in a button.",
    "bad_patterns": ["saving", "deleting", "sending", "loading", "submitting", "processing"],
    "good_examples": ["Save", "Delete", "Send"],
    "exceptions": [],
    "notes": ""
  },
  {
    "id": "ui.button.no_ok",
    "scope": ["interface", "button"],
    "component": "button",
    "severity": "suggestion",
    "lintable": true,
    "rule": "A specific verb or \"Got it\" is usually clearer than \"OK\".",
    "bad_patterns": ["ok", "okay"],
    "good_examples": ["Got it", "Continue", "Save"],
    "exceptions": [],
    "notes": ""
  },
  {
    "id": "ui.form.no_enter_type",
    "scope": ["interface", "form"],
    "component": "label_or_placeholder",
    "severity": "warning",
    "lintable": true,
    "rule": "A label or placeholder usually names the data, not the input action.",
    "bad_patterns": ["enter ", "type ", "write ", "start typing"],
    "good_examples": ["Phone number", "Comment", "Search"],
    "exceptions": [],
    "notes": ""
  },
  {
    "id": "ui.link.meaningful_text",
    "scope": ["interface", "link"],
    "component": "link",
    "severity": "warning",
    "lintable": true,
    "rule": "A link must name the destination or the action.",
    "bad_patterns": ["click here", "read more", "learn more", "this link"],
    "good_examples": ["See pricing details", "Open terms"],
    "exceptions": [],
    "notes": ""
  },
  {
    "id": "ui.language.modal_verbs",
    "scope": ["interface", "language"],
    "component": "any",
    "severity": "suggestion",
    "lintable": true,
    "rule": "Check whether a modal verb is needed or a direct action is better.",
    "bad_patterns": ["need to", "needs to", "must", "should", "have to", "has to", "required to"],
    "good_examples": ["Upload your documents"],
    "exceptions": ["legal text"],
    "notes": ""
  },
  {
    "id": "ui.language.please",
    "scope": ["interface", "language"],
    "component": "any",
    "severity": "suggestion",
    "lintable": true,
    "rule": "Use \"please\" sparingly; it often adds politeness where an action is clearer.",
    "bad_patterns": ["please"],
    "good_examples": ["Upload your documents"],
    "exceptions": ["marketing copy", "legal text"],
    "notes": ""
  },
  {
    "id": "ui.typography.sentence_case",
    "scope": ["interface", "typography"],
    "component": "heading_button_label",
    "severity": "suggestion",
    "lintable": true,
    "rule": "Use sentence case for headings, buttons, and labels.",
    "bad_patterns": ["Save Changes", "Payment Details", "Sign Up Now"],
    "good_examples": ["Save changes", "Payment details", "Sign up"],
    "exceptions": ["product names", "acronyms", "brand names"],
    "notes": ""
  },
  {
    "id": "ui.typography.percent_no_space",
    "scope": ["interface", "typography"],
    "component": "any",
    "severity": "warning",
    "lintable": true,
    "rule": "Do not put a space before the percent sign.",
    "bad_patterns": ["\\d+\\s+%"],
    "good_examples": ["50%"],
    "exceptions": [],
    "notes": ""
  },
  {
    "id": "ui.typography.currency_symbol_before",
    "scope": ["interface", "typography"],
    "component": "any",
    "severity": "warning",
    "lintable": true,
    "rule": "Put the currency symbol before the number, with no space.",
    "bad_patterns": ["\\$\\s+\\d", "\\d\\s+\\$"],
    "good_examples": ["$1,000", "€50"],
    "exceptions": ["currency codes after the number, such as 1,000 USD"],
    "notes": ""
  },
  {
    "id": "ui.typography.thousands_separator",
    "scope": ["interface", "typography"],
    "component": "any",
    "severity": "suggestion",
    "lintable": true,
    "rule": "Separate thousands with commas in English UI numbers.",
    "bad_patterns": ["1000", "15000", "1000000"],
    "good_examples": ["1,000", "15,000", "1,000,000"],
    "exceptions": ["years", "identifiers", "version numbers", "phone numbers"],
    "notes": ""
  },
  {
    "id": "text.typography.no_final_period_in_one_or_two_sentences",
    "scope": ["text", "typography"],
    "component": "any",
    "severity": "warning",
    "lintable": true,
    "rule": "If the text is one or two sentences, do not put a period at the end. In two-sentence text, keep the period between the sentences.",
    "bad_patterns": ["Final period in one- or two-sentence text."],
    "good_examples": ["Done", "Couldn't load your data. Try again"],
    "exceptions": ["Three or more sentences", "Question mark", "Ellipsis"],
    "notes": "Sentence count is determined by sentence boundaries, not by visual line breaks."
  },
  {
    "id": "ui.typography.ellipsis_character",
    "scope": ["interface", "typography"],
    "component": "any",
    "severity": "suggestion",
    "lintable": true,
    "rule": "Use a single ellipsis character, not three periods.",
    "bad_patterns": ["\\.\\.\\."],
    "good_examples": ["Loading…"],
    "exceptions": ["code", "regular expressions"],
    "notes": ""
  },
  {
    "id": "ui.typography.no_exclamation",
    "scope": ["interface", "typography"],
    "component": "any",
    "severity": "suggestion",
    "lintable": true,
    "rule": "An exclamation mark is rarely needed in ordinary UI.",
    "bad_patterns": ["!"],
    "good_examples": ["Done", "Request sent"],
    "exceptions": ["user-generated content"],
    "notes": ""
  },
  {
    "id": "ui.typography.double_space",
    "scope": ["interface", "typography"],
    "component": "any",
    "severity": "suggestion",
    "lintable": true,
    "rule": "Use one space between words and after punctuation.",
    "bad_patterns": ["  "],
    "good_examples": ["Try again later"],
    "exceptions": ["code", "formatted text"],
    "notes": ""
  }
]
